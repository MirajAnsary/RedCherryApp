# ── Server ──────────────────────────────────────────────
PORT=
HOST_API_URL=
HOST_DB_URI=
NODE_ENV=

# ── MongoDB ─────────────────────────────────────────────
MONGODB_URI=

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

# ── Twilio SMS ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── OTP Settings ────────────────────────────────────────
OTP_EXPIRES_MINUTES=
OTP_LENGTH=

# ── CORS ────────────────────────────────────────────────
FRONTEND_URL=

# ── DEV MODE ────────────────────────────────────────────
# ✅ TRUE = OTP prints in your VS Code terminal (no SMS sent)
#    Use this during development — Twilio trial accounts can only
#    send SMS to numbers verified in your Twilio console.
# ✅ Set to false only when going to production with a paid Twilio account.
DEV_SKIP_SMS=
ADMIN_USERNAME=
ADMIN_PASSWORD=

#  // LIVE

# Razorpay Live Keys
# Razorpay Test  Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase (Google sign-in)
FIREBASE_PROJECT_ID=
